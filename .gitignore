# Local ASR benchmark data and generated reports.
tests/asr-benchmark/audio/*
!tests/asr-benchmark/audio/.gitkeep
tests/asr-benchmark/results/*
!tests/asr-benchmark/results/.gitkeep
tests/asr-benchmark/adapters/__pycache__/
tests/asr-benchmark/adapters/*.pyc

# Local diarization benchmark data and generated reports.
tests/diarization-benchmark/audio/*
!tests/diarization-benchmark/audio/.gitkeep
tests/diarization-benchmark/results/*
!tests/diarization-benchmark/results/.gitkeep
tests/diarization-benchmark/research-env/
tests/diarization-benchmark/adapters/__pycache__/
tests/diarization-benchmark/adapters/*.pyc

# Keep transcription-quality configs and generated benchmark output private.
tests/transcription-quality/benchmark-config.json
tests/transcription-quality/ground-truth.json
tests/transcription-quality/private/

# Keep checked-in Tauri icon assets visible despite binary ignores.
!src-tauri/icons/*.ico
!src-tauri/icons/*.icns
!src-tauri/icons/*.png
!src-tauri/icons/**/*.png

